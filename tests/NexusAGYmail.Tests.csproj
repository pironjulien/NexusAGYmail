<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <RootNamespace>NexusAGYmail.Tests</RootNamespace>
    <!-- Source-generated P/Invoke (LibraryImport), as in the engine: NoErrorBoxes.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Test reports outside the sources too (Microsoft.Testing.Platform writes TestResults next to the project otherwise). -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --results-directory "$([System.IO.Path]::Combine('$(NexusBuild)', 'test', 'TestResults'))"</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\native\NexusAGYmail.csproj" />
    <Using Include="Xunit" />
    <AssemblyMetadata Include="NexusAGYmail.Repository" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..'))" />
  </ItemGroup>
</Project>
