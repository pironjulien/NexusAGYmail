<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.15.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>NexusAGYmail</AssemblyName>
    <RootNamespace>NexusAGYmail</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MimeKit" Version="4.18.2" />
    <EmbeddedResource Include="tool-contracts.json" LogicalName="tool-contracts.json" />
    <!-- Shared guardrail policy, byte-identical to the author's common copy (vendored.sha256). -->
    <EmbeddedResource Include="garde-fous.json" LogicalName="garde-fous.json" />
    <!-- Antigravity plugin written by `NexusAGYmail.exe setup`: manifest, logo and skill. -->
    <EmbeddedResource Include="plugin\**\*" LogicalName="plugin/%(RecursiveDir)%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="NexusAGYmail.Tests" />
  </ItemGroup>
</Project>
