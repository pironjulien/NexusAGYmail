<Project>
  <!-- Every build output of the engine goes to ~\.nexus\build\nexusagymail\native: never into OneDrive or AppData. -->
  <PropertyGroup>
    <NexusBuild Condition="'$(NexusBuild)' == ''">$(USERPROFILE)\.nexus\build\nexusagymail\</NexusBuild>
    <BaseOutputPath>$(NexusBuild)native\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(NexusBuild)native\obj\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>
  <!-- .NET analyzers at the recommended level and every warning an error; NuGet restore pinned by packages.lock.json
       (locked mode in CI and release, where CI=true). -->
  <PropertyGroup>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
  </PropertyGroup>
</Project>
